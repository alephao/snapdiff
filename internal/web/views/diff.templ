package views

import (
	"fmt"
	"strings"

	"github.com/alephao/snapdiff/internal/review"
)

type DiffData struct {
	Item      *review.Item
	AxisNames []string
	Position  int    // 1-based position among all items
	Total     int    // total items
	PrevID    string // empty if no prev
	NextID    string // empty if no next
	NoAnim    bool   // set by ?noanim=1 for deterministic screenshot tests
}

templ Diff(d DiffData) {
	@Base(d.Item.Diff.Path, d.NoAnim) {
		@diffTopbar(d)
		<main class="stage">
			<div class="stage-inner">
				@paneSide(d)
				@paneSwipe(d)
				@paneToggle(d)
				@panePixel(d)
				@paneOnion(d)
			</div>
		</main>
		@rightRail(d)
	}
}

templ diffTopbar(d DiffData) {
	<header class="dt-topbar">
		<a class="back" href="/"><span class="arrow">←</span> all diffs</a>
		<div class="breadcrumb">
			@breadcrumbParts(d.Item.Diff.Path)
		</div>
		<div class="nav-prev-next">
			if d.PrevID != "" {
				<a class="nbtn nav-prev" href={ templ.URL("/diff/" + d.PrevID) }><kbd>k</kbd> prev</a>
			} else {
				<span class="nbtn nav-prev disabled"><kbd>k</kbd> prev</span>
			}
			<span class="nbtn"><span class="pos">{ fmt.Sprintf("%d / %d", d.Position, d.Total) }</span></span>
			if d.NextID != "" {
				<a class="nbtn nav-next" href={ templ.URL("/diff/" + d.NextID) }>next <kbd>j</kbd></a>
			} else {
				<span class="nbtn nav-next disabled">next <kbd>j</kbd></span>
			}
		</div>
	</header>
}

templ breadcrumbParts(path string) {
	{{ parts := splitPath(path) }}
	{{ n := len(parts) }}
	if n >= 2 {
		{ parts[n-2] }<span class="sep">/</span>
	}
	if n >= 1 {
		<span class="leaf">{ parts[n-1] }</span>
	}
}

templ paneSide(d DiffData) {
	<section class="pane pane-side is-active" data-mode="side">
		if d.Item.Diff.Status.String() != "added" {
			<div class="col">
				<div class="phone-frame"><img src={ "/diff/" + d.Item.ID + "/baseline.png" } alt="baseline"/></div>
				<div class="phone-label"><span class="h">BASELINE</span> · HEAD</div>
			</div>
		}
		if d.Item.Diff.Status.String() != "deleted" {
			<div class="col">
				<div class="phone-frame"><img src={ "/diff/" + d.Item.ID + "/current.png" } alt="current"/></div>
				<div class="phone-label"><span class="h">CURRENT</span> · working tree</div>
			</div>
		}
	</section>
}

templ paneSwipe(d DiffData) {
	<section class="pane pane-swipe" data-mode="swipe">
		if d.Item.Diff.Status.String() == "modified" {
			<div class="swipe-wrap">
				<div class="phone-frame below"><img src={ "/diff/" + d.Item.ID + "/baseline.png" } alt="baseline"/></div>
				<div class="phone-frame above" id="swipeAbove"><img src={ "/diff/" + d.Item.ID + "/current.png" } alt="current"/></div>
				<div class="splitter" id="swipeSplit"></div>
			</div>
			<div class="swipe-control">
				<span class="lbl">baseline</span>
				<input class="swipe-slider" id="swipeSlider" type="range" min="0" max="100" value="50"/>
				<span class="lbl">current</span>
			</div>
		} else {
			<p style="color:var(--fg-muted);text-align:center;padding:40px">Swipe is only available for modified snapshots.</p>
		}
	</section>
}

templ paneToggle(d DiffData) {
	<section class="pane pane-toggle" data-mode="toggle">
		if d.Item.Diff.Status.String() == "modified" {
			<div class="toggle-wrap" id="toggleWrap">
				<div class="phone-frame below"><img src={ "/diff/" + d.Item.ID + "/baseline.png" } alt="baseline"/></div>
				<div class="phone-frame above"><img src={ "/diff/" + d.Item.ID + "/current.png" } alt="current"/></div>
			</div>
			<div class="toggle-help">
				<span>showing <span class="current-tag" id="toggleLabel">baseline</span></span>
				<span>· hold <kbd>T</kbd> to flip · click to lock</span>
			</div>
		} else {
			<p style="color:var(--fg-muted);text-align:center;padding:40px">Toggle is only available for modified snapshots.</p>
		}
	</section>
}

templ panePixel(d DiffData) {
	<section class="pane pane-pixel" data-mode="pixel">
		<div class="pixel-wrap">
			<div class="phone-frame"><img src={ "/diff/" + d.Item.ID + "/pixeldiff.png" } alt="pixel diff"/></div>
		</div>
		<div class="pixel-legend">
			<span><span class="sw"></span> changed pixels (server-computed)</span>
		</div>
	</section>
}

templ paneOnion(d DiffData) {
	<section class="pane pane-onion" data-mode="onion">
		if d.Item.Diff.Status.String() == "modified" {
			<div class="onion-wrap" id="onionWrap">
				<div class="phone-frame below"><img src={ "/diff/" + d.Item.ID + "/baseline.png" } alt="baseline"/></div>
				<div class="phone-frame above" id="onionAbove" style="opacity:0.5"><img src={ "/diff/" + d.Item.ID + "/current.png" } alt="current"/></div>
			</div>
			<div class="onion-control">
				<span class="lbl" style="color:var(--info)">baseline</span>
				<input class="onion-slider" id="onionSlider" type="range" min="0" max="100" value="50"/>
				<span class="lbl" style="color:var(--accent)">current</span>
			</div>
		} else {
			<p style="color:var(--fg-muted);text-align:center;padding:40px">Onion is only available for modified snapshots.</p>
		}
	</section>
}

templ rightRail(d DiffData) {
	<aside class="rightbar">
		<form class="rb-section rb-verdict" method="post" action={ templ.URL("/diff/" + d.Item.ID + "/verdict") }>
			<span class="rb-label">verdict</span>
			<div class="v-toggle">
				<button type="button" class={ "v-opt is-approve" + onIf(d.Item.Verdict.Status == review.StatusApproved) } id="vApprove">✓ approve <span class="kbd">a</span></button>
				<button type="button" class={ "v-opt is-reject"  + onIf(d.Item.Verdict.Status == review.StatusRejected) } id="vReject">✕ reject <span class="kbd">r</span></button>
			</div>
			<input type="radio" name="status" value="approved" style="display:none" checked?={ d.Item.Verdict.Status != review.StatusRejected }/>
			<input type="radio" name="status" value="rejected" style="display:none" checked?={ d.Item.Verdict.Status == review.StatusRejected }/>
			<input type="hidden" name="next" value={ nextURL(d.NextID) }/>
			<textarea class="v-comment" name="comment" rows="4" placeholder="why? (required for reject — quote the offending region if useful)">{ d.Item.Verdict.Comment }</textarea>
			<button type="submit" class="v-save">save verdict <span class="hint">⌘↵</span></button>
		</form>
		<div class="rb-spacer"></div>
		<div class="rb-section rb-shortcuts">
			<span class="rb-label">shortcuts</span>
			<ul>
				<li><span class="keys"><kbd>1</kbd><span class="sep-key">–</span><kbd>5</kbd></span><span>change mode</span></li>
				<li><span class="keys"><kbd>a</kbd></span><span>approve &amp; next</span></li>
				<li><span class="keys"><kbd>r</kbd></span><span>reject</span></li>
				<li><span class="keys"><kbd>j</kbd></span><span>next diff</span></li>
				<li><span class="keys"><kbd>k</kbd></span><span>prev diff</span></li>
				<li><span class="keys"><kbd>esc</kbd></span><span>back to index</span></li>
			</ul>
		</div>
	</aside>
}

// ---- helpers ----

func onIf(b bool) string {
	if b {
		return " is-on"
	}
	return ""
}

func splitPath(p string) []string { return strings.Split(p, "/") }

func nextURL(id string) string {
	if id == "" {
		return "/"
	}
	return "/diff/" + id
}
